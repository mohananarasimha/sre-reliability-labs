          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (sum by (job) (rate(http_requests_total{status=~\"5..\"}[30s])) or (0 * sum by (job) (rate(http_requests_total[30s])))) / clamp_min(sum by (job) (rate(http_requests_total[30s])), 1e-9)",
          "legendFormat": "{{job}} 5xx %",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx Error Rate (%)",
      "type": "timeseries"
    },
    {
